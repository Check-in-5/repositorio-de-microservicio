# Puerto local/publicado. El servicio dentro de Docker escucha en 3005.
PORT=3005
HOST=127.0.0.1
# Conexión al MySQL de Compose desde npm start en el equipo.
DB_HOST=127.0.0.1
# DB_PORT=3315
DB_PORT=3306
DB_USER=checkin_user
DB_PASSWORD=checkin_password
DB_NAME=checkin_db
DB_ROOT_PASSWORD=rootpassword
BROKER_URL=amqp://ticketu:ticketu_dev@ticketu-rabbitmq:5672/ticketu
EVENT_EXCHANGE=ticketu.events

# Integración Auth: completar con los valores del entorno.
COMPOSE_PROJECT_NAME=checkin
AUTH_SERVICE_URL=http://auth-service:10000
# Fuera de Docker: usar localhost y el puerto publicado por Auth.
# AUTH_INTERNAL_API_KEY debe coincidir con INTERNAL_API_KEY de Auth.
AUTH_INTERNAL_API_KEY=
CHECKIN_ALLOWED_ROLES=STAFF

# URLs alcanzables desde Check-in. PANEL_FAILURE_POLICY: deny o allow.
ENTRADAS_SERVICE_URL=http://entradas-service:3000
ENTRADAS_API_KEY=
PANEL_SERVICE_URL=http://organizador-service:3000
PANEL_API_KEY=
PANEL_FAILURE_POLICY=deny
