# Entrega 3: copiar a .env en la RAIZ. No publicar secretos.
COMPOSE_PROJECT_NAME=checkin
CHECKIN_PORT=3005
FRONTEND_PORT=3015
# Reemplazar por el origen real del navegador (sin ruta ni barra final).
# Para camara desde otro equipo se requiere HTTPS. No es el nombre DNS Docker.
APP_ORIGIN=https://REEMPLAZAR_HOST_CHECKIN

# Plataforma compartida: nombres internos publicados por los otros equipos.
API_GATEWAY_URL=http://ticketu-api-gateway:8080
AUTH_SERVICE_URL=http://auth-service:10000
AUTH_INTERNAL_API_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# El Gateway oficial mantiene /api/entradas, no /api/v1/entradas.
ENTRADAS_DETAIL_PATH=/api/entradas/{id}/detalle
# Dependencia auxiliar: el Gateway revisado NO publica /api/v1/panel.
# Si plataforma incorpora esa ruta, cambiar esta URL al Gateway.
PANEL_SERVICE_URL=http://organizador-service:3000
PANEL_EVENT_PATH=/api/v1/panel/eventos/{id}

# Publicador historico opcional: no se amplia ni se declara BR1 como cumplido.
BROKER_URL=
EVENT_EXCHANGE=ticketu.events
